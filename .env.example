# Copy to .env.local and fill in once decided.

# Final domain (PRD open question Q6). Used in robots.txt/sitemap.xml absolute URLs.
NEXT_PUBLIC_SITE_URL=https://sarkariformedit.example

# Plausible analytics domain. Leave unset to ship with analytics fully off.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Inbox the "request a preset" form (A15) mails to.
NEXT_PUBLIC_PRESET_REQUEST_EMAIL=presets@sarkariformedit.example
